{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored Video Script YAML",
  "description": "Source video-script.yml; distinct from published video-script.schema.json.",
  "type": "object",
  "required": ["title", "video", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "video": {
      "type": "object",
      "required": ["url"],
      "properties": { "url": { "type": "string" } },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "time", "visual", "script", "purpose"],
              "properties": {
                "type": { "type": "string", "enum": ["SCENE", "TRANSITION"] },
                "title": { "type": "string" },
                "time": { "type": "string" },
                "visual": { "type": "string", "minLength": 1 },
                "script": { "type": "string", "minLength": 1 },
                "purpose": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
