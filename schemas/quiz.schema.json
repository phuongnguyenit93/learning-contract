{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quiz Questions",
  "description": "Quiz question.yml, validated after YAML parsing. Question schema-version in source comments is independent of the shared contract version.",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "answers", "correctAnswerId", "aiGenerated", "reviewed", "readmeRelated", "apiRelated"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string" },
          "aiGenerated": { "type": "boolean" },
          "reviewed": { "type": "boolean" },
          "readmeRelated": { "$ref": "./common.schema.json#/$defs/readmeRelation" },
          "apiRelated": { "$ref": "./common.schema.json#/$defs/apiRelation" },
          "correctAnswerId": { "$ref": "#/$defs/answerId" },
          "answers": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "answer", "explanation"],
              "properties": {
                "id": { "$ref": "#/$defs/answerId" },
                "answer": { "type": "string" },
                "explanation": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": { "answerId": { "enum": ["A", "B", "C", "D"] } }
}
