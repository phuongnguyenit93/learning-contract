{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Search Index",
  "description": "search/knowledge-search.{language}.json published by the producer.",
  "type": "object",
  "required": ["version", "language", "documentCount", "documents"],
  "properties": {
    "version": { "const": 1 },
    "language": { "$ref": "./common.schema.json#/$defs/language" },
    "documentCount": { "$ref": "./common.schema.json#/$defs/nonnegativeInteger" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["documentId", "type", "moduleId", "categoryId", "categoryTitle", "title", "sourcePath", "preview", "searchText"],
        "properties": {
          "documentId": { "type": "string" },
          "type": { "enum": ["CATEGORY", "SECTION"] },
          "moduleId": { "$ref": "./common.schema.json#/$defs/routeId" },
          "categoryId": { "type": "string" },
          "categoryTitle": { "type": "string" },
          "sectionId": { "type": "string" },
          "title": { "type": "string" },
          "sourcePath": { "type": "string" },
          "difficulty": { "$ref": "./common.schema.json#/$defs/difficulty" },
          "preview": { "type": "string" },
          "searchText": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
