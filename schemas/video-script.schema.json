{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Script",
  "description": "module/{moduleId}/video/{language}/content/{categoryId}/script.json.",
  "type": "object",
  "required": ["version", "moduleId", "language", "categoryId", "title", "sourcePath", "video", "sections"],
  "properties": {
    "version": { "const": 1 },
    "moduleId": { "$ref": "./common.schema.json#/$defs/routeId" },
    "language": { "$ref": "./common.schema.json#/$defs/language" },
    "categoryId": { "type": "string" },
    "title": { "type": "string" },
    "sourcePath": { "type": "string" },
    "video": {
      "type": "object",
      "required": ["url"],
      "properties": { "url": { "type": "string" } },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "title", "items"],
        "properties": {
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "time", "visual", "script", "purpose"],
              "properties": {
                "type": { "enum": ["SCENE", "TRANSITION"] },
                "title": { "type": "string" },
                "time": { "type": "string" },
                "visual": { "type": "string" },
                "script": { "type": "string" },
                "purpose": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
